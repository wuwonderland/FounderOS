# FOUNDER OS — copy to .env.local and fill in. .env.local is gitignored.

# ── Email (up to 4 IMAP inboxes) ─────────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → 2FA → App passwords)
INBOX_1_HOST=imap.gmail.com
INBOX_1_USER=
INBOX_1_PASS=
INBOX_1_NAME=
# INBOX_1_PORT=993            # optional, defaults to 993
INBOX_2_HOST=
INBOX_2_USER=
INBOX_2_PASS=
INBOX_3_HOST=
INBOX_3_USER=
INBOX_3_PASS=
INBOX_4_HOST=
INBOX_4_USER=
INBOX_4_PASS=

# ── Slack ────────────────────────────────────────────────────────────────
# Bot token (xoxb-…) with scopes: channels:read, channels:history, users:read
SLACK_BOT_TOKEN=
# Fallback when no bot token is set — a token from Slack's token-rotation
# flow (xoxe.xoxp-…). Note: this is a USER token and it EXPIRES (Slack's
# auth.test reports expires_in); there's no refresh-token exchange wired up
# here, so a connected state here goes stale once the token expires.
SLACK_ACCESS_TOKEN=
# xapp-… — only needed if/when Socket Mode is wired up. Unused today.
SLACK_APP_TOKEN=
# Verifies inbound Events API / interactivity requests (app/api/slack/
# events, app/api/slack/actions) are really from Slack. Required — both
# routes fail closed (refuse every request) without this set.
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs allowed to approve a Dev Team Agent
# write ("Approve & Apply" button, or "@Jarvis approve <task_id>"). Empty
# = nobody is authorized — the safe default. Find your own ID via
# GET /api/slack/test (userId field) or Slack → profile → "Copy member ID".
SLACK_APPROVAL_USER_IDS=

# ── Payment processors ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # full client implemented (balance + charges)
PAYPAL_CLIENT_ID=             # registered; client lands when keys do
PAYPAL_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WHOP_API_KEY=

# ── Notion ───────────────────────────────────────────────────────────────
# Internal integration secret; share target pages with the integration
NOTION_API_KEY=
# Database the Dev Team Agent pulls task specs/acceptance criteria from
# (lib/connectors/notion.ts fetchCriteria) — share this database with the
# integration too, separately from individual pages above.
NOTION_DATABASE_ID=

# ── GitHub (Dev Team Agent memory: .github/agent/*.md) ────────────────────
# Personal access token. MUST have PUSH access to GITHUB_REPO — a read-only
# token means updateMemory() silently fails every write. Do NOT assume
# this app's own `git remote` is the right repo; point it at one you
# actually control.
GITHUB_TOKEN=
GITHUB_REPO=                  # "owner/repo"
# GITHUB_MEMORY_PATH=.github/agent   # override the folder holding the 4 memory files
# GITHUB_MEMORY_BRANCH=              # override the branch (defaults to the repo's default branch)

# ── Launchpad Cohort ───────────────────────────────────────────────────
WEBINARJAM_API_KEY=          # account-wide key; pulls webinar registrants/attendees
TRAKYO_API_KEY=              # revenue attribution; status-only until Trakyo ships an API
GHL_API_KEY=                 # GoHighLevel Private Integration token (Settings → Private Integrations, read scopes)
GHL_LOCATION_ID=             # the LC sub-account location id (visible in the GHL URL: /v2/location/<id>/…)

# ── G-Brain ──────────────────────────────────────────────────────────────
# Defaults work: gbrain CLI on PATH, store at knowledge/brain-store
# BRAIN_PROVIDER=gbrain       # set to "stub" to disable
# GBRAIN_BIN=                 # override CLI path
# GBRAIN_STORE=               # override brain-store path
# GBRAIN_DISABLE_DIRECT_POOL=1

# ── ElevenLabs (Voice HUD spoken responses) ──────────────────────────────
# Without a key, the Voice HUD shows recognized speech as text only (no fake
# spoken response). ElevenLabs → Profile → API keys.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # defaults to the "Adam" preset

# ── LLM (agent & Conductor chat, OrbJarvis /api/voice/brain) ─────────────
# Without any key below (and without the Hermes proxy running), agent chat
# reports "not configured" (no fake "connected"). Preference order at call
# time: local Hermes proxy → Vercel AI Gateway → native Anthropic → native
# OpenAI — each one is only tried if the previous is unreachable/unconfigured
# or actually fails (e.g. an expired gateway key, insufficient credit),
# never a fabricated reply.
# HERMES_PROXY_URL=http://127.0.0.1:8645/v1   # `hermes proxy start` — free, OAuth-backed, no per-token billing
# HERMES_MODEL=poolside/laguna-s-2.1:free      # model id the Hermes proxy routes to
AI_GATEWAY_API_KEY=           # Vercel AI Gateway key
ANTHROPIC_API_KEY=            # native Anthropic key; used if Hermes + the gateway aren't configured/working
OPENAI_API_KEY=               # native OpenAI key; used if Hermes + gateway + Anthropic aren't configured/working
# LLM_PROVIDER=gateway        # pin to one provider: hermes | gateway | anthropic | openai | stub (stub = deterministic, offline)
# LLM_MODEL=anthropic/claude-sonnet-4-6   # "provider/model" routed via gateway
# ANTHROPIC_MODEL=claude-sonnet-5         # model id for the native Anthropic fallback
# OPENAI_MODEL=gpt-4o                     # model id for the native OpenAI fallback

# ── Beehiiv (email list) ─────────────────────────────────────────────────
# Without both, the Social email-list card stays seeded dummy (no fake number).
BEEHIIV_API_KEY=             # Beehiiv API key
BEEHIIV_PUBLICATION_ID=      # publication id (pub_...)

# ── ManyChat (Instagram DM automation) ───────────────────────────────────
# Lights up the ManyChat connector on /integrations. ManyChat → Settings → API.
# The API cannot list DMs — the live /social DM inbox is fed by the webhook
# below, not by this key.
MANYCHAT_API_KEY=            # ManyChat API key
# Optional shared secret: if set, /api/webhooks/manychat requires header
# `x-manychat-secret` to match (put the same value in the ManyChat External
# Request headers). Leave blank to accept unauthenticated posts (dev only).
MANYCHAT_WEBHOOK_SECRET=

# ── Payments processors (Finances) ───────────────────────────────────────
# Stripe is fully wired; the rest are honest "not configured" until keyed.
# STRIPE_SECRET_KEY=         # sk_live_… / sk_test_… (already above if set)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FANBASIS_VANTAGE_KEY=       # FanBasis · Vantage
FANBASIS_LC_KEY=             # FanBasis · Launchpad Cohort
WISE_1_TOKEN=                # Wise account 1 (income + outgoing transfers)
WISE_2_TOKEN=                # Wise account 2

# ── Email send (SMTP, optional per inbox) ────────────────────────────────
# Comms email replies send for real via SMTP using each inbox's user/pass.
# Defaults: host = INBOX_n_HOST with imap.→smtp., port 465. Override per slot:
# INBOX_1_SMTP_HOST=smtp.gmail.com
# INBOX_1_SMTP_PORT=465

# ── Comms lane routing (optional) ────────────────────────────────────────
# Extra keywords that force a message into the /comms Work lane, comma-separated,
# matched against its inbox / sender / subject. Add your brands + key clients.
# Generic work signals (invoice, contract, proposal, …) are built in.
# COMMS_WORK_KEYWORDS=Acme,Northwind,Jane Client

# ── Supabase (agent_memories pgvector store + CRM users table) ───────────
# Route A: Supabase + pgvector augments the existing sqlite data model — it
# doesn't replace it. Server-only; without both, lib/agents/memory.ts and
# lib/crm/users.ts no-op honestly (agent chat still works off sqlite alone).
# Project Settings → API on your Supabase project dashboard. Apply
# supabase/migrations/0001-0003 in the SQL Editor first — see
# supabase/migrations/README.md for the exact steps.
NEXT_PUBLIC_SUPABASE_URL=     # https://<project-ref>.supabase.co — safe to expose client-side
SUPABASE_SERVICE_ROLE_KEY=    # bypasses RLS — server-only, NEVER prefix with NEXT_PUBLIC_

# ── App ──────────────────────────────────────────────────────────────────
# FOUNDER_OS_DB=              # override SQLite path
